POCKETCASTS_EMAIL=
POCKETCASTS_PASSWORD=
# The password asked by the app
APP_PASSWORD=
# The keys of the push notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: the date you stopped using your previous podcast app, read by `yarn report --unarchive`
PREVIOUS_APP_UNTIL=
# Optional: comma-separated podcasts you never listened to elsewhere, read by `yarn report --unarchive`
NEVER_HEARD_PODCASTS=
# Optional: share the state of the app with the scripts, which otherwise keep it in `.state`
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
